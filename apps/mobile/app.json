{
  "expo": {
    "name": "MadPix",
    "slug": "madpix",
    "version": "0.2.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "madpix",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.madpixdev.madpix",
      "adaptiveIcon": {
        "backgroundColor": "#5B8DE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B8DE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B8DE6"
        }
      ],
      "./plugins/with-android-build-settings"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.madpixdev.madpix"
    },
    "owner": "madpixdev",
    "extra": {
      "eas": {
        "projectId": "bdf1bb8a-b622-496c-b9f9-6bf1c3b453b3"
      }
    },
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/bdf1bb8a-b622-496c-b9f9-6bf1c3b453b3"
    }
  }
}
