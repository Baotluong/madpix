{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "madpix-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/mobile", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "madpix-web-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "--single", "--listen", "8092", "apps/mobile/dist"],
      "port": 8092
    }
  ]
}
